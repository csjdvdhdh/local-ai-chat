# PostgreSQL connection string from Railway. Keep private.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

# Public HTTPS URL of this Railway web service.
PUBLIC_BASE_URL=https://your-app.up.railway.app
COOKIE_SECURE=true
PRODUCTION=true

# Railway account/workspace API token and the workspace ID where isolated bot projects are created.
# Use a dedicated least-privilege workspace token. Never put this token in a bot service.
RAILWAY_API_TOKEN=
RAILWAY_WORKSPACE_ID=

# Required on Railway before signups can be opened. Share only with users you approve.
PLATFORM_INVITE_CODE=replace-with-a-random-invite-code

# Cost-safety limits. Each bot gets a separate Railway project and service.
MAX_BOTS_PER_USER=1
MAX_TOTAL_BOTS=10
